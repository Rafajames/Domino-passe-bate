# Preencha para habilitar recursos online (Etapa 5). Sem estas variáveis o jogo roda 100% offline.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endereço público do jogo na web, usado no link de convite do app Android (ex.: https://meu-jogo.vercel.app/).
# Vazio: no app o convite vai só com o código da sala.
VITE_PUBLIC_URL=
